# Copy to .env and fill in ONE provider's key. .env is gitignored; never commit it.

# --- Pick one provider and paste its key ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Which models to use (LiteLLM names: provider/model) ---
# Primary answers every question; fallback is used only if the primary fails.
# Examples:
#   Anthropic: anthropic/claude-sonnet-5-5   and  anthropic/claude-haiku-5-5
#   OpenAI:    openai/gpt-4o                 and  openai/gpt-4o-mini
#   Gemini:    gemini/gemini-2.5-pro         and  gemini/gemini-2.5-flash
PRIMARY_MODEL=
FALLBACK_MODEL=

# --- Web app (api/ + web/) ---
# Every demo customer signs in with this password. A bank would use its own identity provider.
DEMO_PASSWORD=demo1234
REDIS_URL=redis://localhost:6380/0
# Set to 1 when served over HTTPS, so the session cookie is only sent securely.
COOKIE_SECURE=0
